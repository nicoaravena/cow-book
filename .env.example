# Copy to .env (gitignored) and fill in. Names only here, never real values.

# Password for the local compose database user `cowbook`.
POSTGRES_PASSWORD=

# Host port for the compose database.
POSTGRES_PORT=5432

# Connection string for goose and, from 2.4, the app. Use the same password.
DATABASE_URL=postgres://cowbook:<password>@localhost:5432/cowbook?sslmode=disable

# cowbook serve (3.1). Both optional; the values shown are the defaults.
# Address to listen on. localhost keeps it off the network.
COWBOOK_ADDR=localhost:8080
# debug, info, warn or error.
COWBOOK_LOG_LEVEL=info
