; https://editorconfig.org/

[*]
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 88
end_of_line = lf
charset = utf-8

[Makefile]
indent_style = tab
indent_size = 2

[*.{go,mod}]
indent_style = tab
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
max_line_length = 78
trim_trailing_whitespace = false
eclint_indent_style = unset
